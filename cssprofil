.themis-profile-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}
.themis-profile-tab {
  padding: 20px;
  border-radius: 12px;
  text-align: center;
  background: var(--bg-neutre);
  border: 1px solid var(--bord-neutre);
  color: var(--txt-noir-neutre);
  font: 400 24px Coolvetica;
  text-transform: uppercase;
  cursor: pointer;
  transition: .35s ease;
}
.themis-profile-tab:hover {
  background: var(--bg-neutre-terti);
  border: 1px solid var(--bord-neutre-terti);
}
.themis-profile-tab.is-active {
  background: var(--group-color);
  color: var(--txt-brand-neutre);
}
.themis-profile-hidden-fields {
  display: none;
} 
.themis-profile-tab-content {
  display: none;
}
.themis-profile-tab-content.is-active {
  display: block;
}
.themis-profile-placeholder {
  min-height: 300px;
  padding: 40px;
  background: var(--bg-neutre);
}
.themis-profile-placeholder h2 {
  margin: 0;
  font: 400 30px Coolvetica;
  color: var(--txt-noir-neutre);
}
  .themis-home, #page-header {display: none;}
  #themis-profile-age::after {content: " ans";}
  
 .themis-profile-about {
  grid-area: about;
  padding: 18px;
  border-radius: 8px;
  background: var(--bg-second);
  border: 1px solid var(--bord-neutre-second);
  display: flex;
  flex-direction: column;
  height: 470px;
  position: relative;
}
.themis-profile-about > .themis-profile-editable-value {
  flex: 1;
  min-height: 0;
}
.themis-profile-about-text {
  height: 100%;
  overflow-y: auto;
  scrollbar-width: none;
  color: var(--txt-noir-neutre);
  font: 400 12px Inter;
}
.themis-profile-about-text::-webkit-scrollbar {
  display: none;
}
  .themis-profile-about .themis-profile-edit-button {
  position: absolute;
  top: 10px;
  right: 10px;
}
.themis-profile-quote {
  flex-shrink: 0;
  display: flex;
  gap: 12px;
  margin-top: 20px;
  padding: 15px;
  border-radius: 8px;
  background: var(--bg-neutre);
  color: var(--txt-noir-neutre);
  font: italic 12px/1.5 Inter;
  position: relative;
}
  .themis-profile-quote .themis-profile-edit-button {
  position: absolute;
  bottom: 30px;
  right: 5px;
}
  .themis-profile-section-title {
  margin-bottom: 14px;
  color: var(--txt-noir-neutre);
  font: 700 14px Inter;
  text-transform: uppercase;
}
  .themis-profile-rp-column {
  grid-area: rp;
  display: flex;
  flex-direction: column;
  height: fit-content;
}
  .themis-profile-character-infos {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
  .themis-profile-character-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  border: 1px solid var(--bord-neutre);
  border-radius: 8px;
  background: var(--bg-second);
  padding: 15px;
  position: relative;
}
  .themis-profile-character-info .themis-profile-edit-button {
  position: absolute;
  right: -5px;
  top: -5px;
}
  .themis-profile-character-info .themis-profile-inline-editor {
  width: 102px;
}
  .themis-profile-character-info > span {
  color: var(--txt-noir-neutre);
  font: 700 14px Inter;
  text-transform: uppercase;
}
  .themis-profile-character-info strong {
  color: var(--txt-noir-neutre);
  font: 500 12px Inter;
}
  .themis-profile.is-edit-mode .themis-profile-character-banner .themis-profile-edit-button {
  position: absolute;
  top: 10px;
  right: 10px;
  display: inline-block!important;
}
  .themis-profile-collection {
  grid-area: badges;
  display: grid;
  grid-template-columns: minmax(0, .8fr) minmax(0, 1.6fr);
  gap: 14px;
}
  .themis-profile-badges, .themis-profile-talents {
  padding: 18px;
  border: 1px solid var(--bord-neutre);
  border-radius: 8px;
  background: var(--bg-second);
  position: relative;
}
  .themis-profile-collection .themis-profile-edit-button {
  position: absolute;
  top: 10px;
  right: 10px;
}
  .themis-profile-badges-list {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 10px;
}
  .themis-profile-talents-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px 24px;
}
  .themis-profile-talent-rank {
  display: grid;
  grid-template-columns: 30px minmax(0, 1fr);
  align-items: center;
  gap: 8px;
}
  .themis-profile-talent-rank-label {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border-radius: 8px;
  color: var(--txt-brand-neutre);
  font: 700 14px Inter;
}
  .themis-profile-talent-rank-list {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  gap: 6px;
}
  .themis-profile-talent {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1;
  border: 1px solid var(--bord-neutre);
  border-radius: 6px;
  background: var(--bg-neutre);
}
.themis-profile-talent img {
  display: block;
  width: 40px;
  height: 40px;
  object-fit: contain;
  transition: .2s ease;
}
.themis-profile-badge.is-locked img, .themis-profile-talent.is-locked img {
  opacity: .2;
  filter: grayscale(1);
}
.themis-profile-badge.is-unlocked img, .themis-profile-talent.is-unlocked img {
  opacity: 1;
  filter: none;
}
.themis-profile-badge:hover img, .themis-profile-talent:hover img {
  transform: scale(1.08);
}
  .rank-d {
  background: #d9bd91;
}
.rank-c {
  background: #9fd2b0;
}
.rank-b {
  background: #8fc5e8;
}
.rank-a {
  background: #b79bd9;
}
.rank-s {
  background: #ed939d;
}
.rank-x {
  background: linear-gradient(135deg, #ef8e9b 0%, #c58ed8 48%, #efc35f 100%);;
}
  .themis-profile-full {
  background: var(--group-color);
  width: 100%;
  height: 37px;
  margin-top: 12px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
  color: var(--txt-brand-neutre);
  font: 700 14px Inter;
  text-transform: uppercase;
  }
  .themis-profile-collection-editable > .themis-profile-edit-button {
  display: none !important;
}
  .themis-profile.is-edit-mode .themis-profile-collection-editable > .themis-profile-edit-button {
  display: flex !important;
}
  .themis-profile-collection-actions {
  display: none;
}
  .themis-profile.is-edit-mode .themis-profile-collection-editable.is-editing .themis-profile-collection-actions {
  display: flex;
}
  .themis-profile-collection-editable.is-editing .themis-profile-badge img, .themis-profile-collection-editable.is-editing .themis-profile-talent img {
  cursor: pointer;
}
  .themis-profile-badge {
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--bord-neutre);
  border-radius: 8px;
  background: var(--bg-neutre);
}
  .themis-profile-badge, .themis-profile-talent {
  position: relative;
}
  .themis-profile-badge img {
  transition: .2s ease;
}
.themis-profile-badge > span, .themis-profile-talent-tooltip {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 12px);
  z-index: 50;
  padding: 9px 13px;
  border-radius: 8px;
  background: var(--bg-neutre);
  box-shadow: 0 5px 16px rgb(64 82 94 / 14%);
  color: var(--txt-noir-neutre);
  font: 600 11px Inter;
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transform: translate(-50%, 5px);
  transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
}
  .themis-profile-badge > span::after, .themis-profile-talent-tooltip::after {
  content: "";
  position: absolute;
  left: 50%;
  top: calc(100% - 5px);
  width: 10px;
  height: 10px;
  border-radius: 1px;
  background: var(--group-color);
  border: 2px solid var(--bg-neutre);
  transform: translateX(-50%) rotate(45deg);
}
.themis-profile-badge:hover > span, .themis-profile-talent:hover > .themis-profile-talent-tooltip {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0);
}
.themis-profile-talent-tooltip {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 7px 16px;
  width: 320px;
  padding: 15px 17px;
  white-space: wrap;
  transform: translate(-50%, 6px);
}
.themis-profile-talent-tooltip strong {
  min-width: 0;
  color: var(--txt-noir-neutre);
  font: 700 13px Inter;
  text-align: left;
}
.themis-profile-talent-tooltip em {
  padding: 5px 8px;
  border-radius: 5px;
  background: var(--group-color);
  color: var(--txt-brand-neutre);
  font: normal 700 9px Inter;
  text-transform: uppercase;
  white-space: nowrap;
}
.themis-profile-talent-tooltip small {
  grid-column: 1 / -1;
  display: block;
  margin-top: 3px;
  color: var(--txt-noir-neutre);
  font: 400 11px/1.55 Inter;
  text-align: left;
}
.themis-profile-talent:nth-child(8n + 7) .themis-profile-talent-tooltip, .themis-profile-talent:nth-child(8n + 8) .themis-profile-talent-tooltip {
  left: auto;
  right: 0;
  transform: translateY(6px);
}
.themis-profile-talent:nth-child(8n + 7):hover .themis-profile-talent-tooltip, .themis-profile-talent:nth-child(8n + 8):hover .themis-profile-talent-tooltip {
  transform: translateY(0);
}
.themis-profile-talent:nth-child(8n + 7) .themis-profile-talent-tooltip::after, .themis-profile-talent:nth-child(8n + 8) .themis-profile-talent-tooltip::after {
  left: auto;
  right: 12px;
  transform: rotate(45deg);
}
  .themis-profile-header-rp-bottom {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
  .themis-profile-header-rp-bottom>:first-child {
  background: var(--bg-orange-second);
  border: 1px solid var(--bord-orange-second);
}
  .themis-profile-header-rp-bottom>:last-child {
  background: var(--bg-bleu-second);
  border: 1px solid var(--bord-bleu-second);
}
  .themis-profile-reply-bars {
  display: flex;
  gap: 5px;
}
  
